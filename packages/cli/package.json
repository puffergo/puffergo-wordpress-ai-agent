{
  "name": "puffergo",
  "version": "0.1.0",
  "description": "AI agent CLI for WordPress: bulk product upload and SEO silo sync. Credentials stay on your machine.",
  "type": "module",
  "bin": {
    "puffergo": "./bin/puffergo.mjs"
  },
  "scripts": {
    "silo": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@puffergo/silo-core": "workspace:*",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "tsx": "^4.19.2",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puffergo/puffergo-wordpress-ai-agent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/puffergo/puffergo-wordpress-ai-agent#readme"
}
