{
  "name": "puffergo",
  "version": "1.7.0",
  "private": true,
  "description": "AI agent CLI for WordPress: bulk product upload and SEO silo sync. Credentials stay on your machine.",
  "type": "module",
  "bin": {
    "puffergo": "./bin/puffergo.mjs"
  },
  "scripts": {
    "silo": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@puffergo/silo-core": "workspace:*",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "5.5.4",
    "vitest": "^2.1.9",
    "esbuild": "^0.25.1"
  },
  "license": "MIT"
}
